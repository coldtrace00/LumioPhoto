#include <winver.h>
#include "resource.h"

IDI_APPICON     ICON    "@ICON_FILE@"
1               24      "@MANIFEST_FILE@"
IDR_PAYLOAD     RCDATA  "@PAYLOAD_FILE@"
IDR_UNINSTALLER RCDATA  "@UNINSTALLER_FILE@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @APP_VERSION_COMMA@,0
PRODUCTVERSION  @APP_VERSION_COMMA@,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "Lumio Photo Setup\0"
            VALUE "FileVersion",      "@APP_VERSION@\0"
            VALUE "ProductName",      "Lumio Photo\0"
            VALUE "ProductVersion",   "@APP_VERSION@\0"
            VALUE "OriginalFilename", "LumioPhoto-Setup.exe\0"
            VALUE "LegalCopyright",   "MIT License\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
